#region Prolog
MinorErrorLogMax = -1;
OnMinorErrorDoItemSkip = 1;
NumRowsRead = 0;
NumRowsProcessed = 0;
SetInputCharacterSet('TM1CS_ISO_8859_9');
CubeClearData('QC mMultivariate');
CubeClearData('}CellAnnotations_QC mMultivariate');
#endregion
#region Data
NumRowsRead = NumRowsRead + 1;
CellPutN(StringToNumberEx(vValue1,'.',','),'QC mMultivariate',vDim1_1,vDim2_1,vDim3_1);
NumRowsProcessed = NumRowsProcessed + 1;
#endregion
#region Epilog
If (pResult @<> '');
TextOutput(pResult, NumberToString(NumRowsRead), NumberToString(NumRowsProcessed));
EndIf;
#endregion